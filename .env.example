# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# One of: development | testing | production
APP_ENVIRONMENT=development
APP_NAME=rag-platform
APP_VERSION=0.1.0

# Logging: one of DEBUG | INFO | WARNING | ERROR | CRITICAL
APP_LOG_LEVEL=INFO
# Log renderer: "console" (human-readable, dev) or "json" (structured, prod)
APP_LOG_FORMAT=console

# Server
APP_HOST=0.0.0.0
APP_PORT=8000

# API
APP_API_V1_PREFIX=/api/v1

# CORS — comma-separated list of allowed origins. Empty = none allowed.
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000

# Trusted hosts — comma-separated list. "*" allows any (dev only).
APP_ALLOWED_HOSTS=*

# ---------------------------------------------------------------------------
# Authentication (Phase 2)
# ---------------------------------------------------------------------------
# HMAC secret used to sign/verify JWTs. The default below is for local
# development ONLY — the app refuses to start with it if
# APP_ENVIRONMENT=production. Generate a real secret for anything else,
# e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_JWT_SECRET_KEY=insecure-development-secret-change-me
APP_JWT_ALGORITHM=HS256
APP_ACCESS_TOKEN_EXPIRE_MINUTES=15
APP_REFRESH_TOKEN_EXPIRE_DAYS=7

# Optional local/dev convenience: if both are set, an ADMIN-role user with
# these credentials is created on startup (idempotent — safe to leave set
# across restarts). Self-registration via POST /auth/register always
# assigns the MEMBER role, so without this there's no way to reach an
# admin-only endpoint on a fresh Phase 2 deployment. Leave unset in any
# environment where this isn't wanted.
APP_BOOTSTRAP_ADMIN_EMAIL=
APP_BOOTSTRAP_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Database (Phase 3)
# ---------------------------------------------------------------------------
# Points at the `postgres` service in docker-compose.yml. Host port is
# 5433, not Postgres's default 5432 — deliberately, so this never collides
# with (or gets silently intercepted by) a Postgres already installed
# natively on your machine. Container-to-container traffic (the `api`
# service talking to `postgres` inside Docker) is unaffected by this and
# always uses the real 5432 internally; this only matters for host-side
# tools (psql, `make dev` run outside Docker, etc.).
APP_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/rag_platform
APP_DATABASE_POOL_SIZE=5
APP_DATABASE_MAX_OVERFLOW=10
# Logs every SQL statement — verbose, dev/debugging only.
APP_DATABASE_ECHO=false

# NOTE on testing: `make test` does NOT read this (or anything else in this
# file) for its database connection — it always starts Docker Compose's
# postgres itself and hard-overrides the test database URL to point at it,
# specifically so test runs are reproducible regardless of what's in your
# environment or installed on your machine. See the `test` target in
# `Makefile` for the exact mechanism.
#
# APP_TEST_DATABASE_URL below is only consulted if you run `pytest` (or
# `poetry run pytest`) directly, bypassing `make test` — useful if you'd
# rather point tests at a non-Docker Postgres for some reason. Must point
# at a database dedicated to tests — every table in it is truncated before
# each test run.
# APP_TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/rag_platform_test

# ---------------------------------------------------------------------------
# Cache / Redis (Phase 4)
# ---------------------------------------------------------------------------
# Points at the `redis` service in docker-compose.yml. Host port is 6380,
# not Redis's default 6379 — same rationale as Postgres's 5433 above.
APP_REDIS_URL=redis://localhost:6380/0
APP_REDIS_MAX_CONNECTIONS=20
# TTL for cached refresh-token revocation lookups (see
# identity_access/infrastructure/repositories/cached_refresh_token_store.py
# and ADR-0007). Deliberately short — a stale "not revoked" cache entry is
# a real, if narrow, security exposure window.
APP_REFRESH_TOKEN_CACHE_TTL_SECONDS=60

# Same rationale/behavior as APP_TEST_DATABASE_URL above, for Redis. Only
# consulted by direct `pytest` runs, not `make test` (which always uses
# Docker's redis on its own logical DB index, 1, regardless of this).
# APP_TEST_REDIS_URL=redis://localhost:6380/1
